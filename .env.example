# ============================================================
# .env.example — copie para .env e preencha com seus dados
# ============================================================

# --- Banco de dados (PostgreSQL) ---
# Cole aqui a DATABASE_URL do Replit (Secrets → DATABASE_URL)
DATABASE_URL=postgresql://usuario:senha@localhost:5432/atelie_costura

# Ou use variáveis individuais:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=sua_senha
# PGDATABASE=atelie_costura

# --- Banco SQLite (alternativa) ---
# SQLITE_DB=./data/atelie.db

# --- Aplicação ---
SECRET_KEY=troque-por-uma-chave-secreta-forte
NODE_ENV=production
PORT=3000

# --- Uploads / Arquivos ---
# UPLOAD_DIR=./uploads
